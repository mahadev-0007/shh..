# Build environment for the Ubuntu port: docker build -f Dockerfile.build -t shh-build .
FROM ubuntu:24.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential ca-certificates curl pkg-config git dpkg-dev \
      libgtk-4-dev libadwaita-1-dev libvte-2.91-gtk4-dev \
      xvfb xauth dbus-x11 openssh-client && rm -rf /var/lib/apt/lists/*
RUN curl -sSf https://sh.rustup.rs | sh -s -- -y --profile minimal --default-toolchain stable
ENV PATH=/root/.cargo/bin:$PATH CARGO_TARGET_DIR=/target
WORKDIR /work
